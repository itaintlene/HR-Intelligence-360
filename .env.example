# --- LLM (all optional; the system runs with deterministic fallbacks if none is set) ---
# OpenAI-compatible API
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8000/v1
# HR360_LLM_MODEL=gpt-4o-mini
# Or Ollama
# OLLAMA_MODEL=llama3.1
# HR360_LLM=auto            # auto | openai | ollama | none

# --- Embeddings ---
# HR360_EMBEDDINGS=auto     # auto | sbert | hash   (hash = offline fallback)

# --- Demo clock: dates in synthetic data are generated relative to this day ---
# HR360_AS_OF=2026-11-16

# --- Optional LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
