---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	supervisor(supervisor)
	dispatch(dispatch)
	document_intelligence(document_intelligence)
	policy(policy)
	audit(audit)
	workflow(workflow)
	report(report)
	approval(approval)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> supervisor;
	approval --> dispatch;
	audit --> dispatch;
	dispatch -.-> approval;
	dispatch -.-> audit;
	dispatch -.-> document_intelligence;
	dispatch -.-> finalize;
	dispatch -.-> policy;
	dispatch -.-> report;
	dispatch -.-> workflow;
	document_intelligence --> dispatch;
	policy --> dispatch;
	report --> dispatch;
	supervisor --> dispatch;
	workflow --> dispatch;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
